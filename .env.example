# Local environment configuration.
# Copy this file to .env and adjust as needed.
# In production, set environment variables via server or container configuration instead.
APP_ENV=dev
APP_DEBUG=true

# Database. The driver is chosen from the DSN scheme.
# sqlite:  DB_DSN=sqlite:/absolute/path/app.sq3   (default: runtime/app.sq3)
# mysql:   DB_DSN=mysql:host=127.0.0.1;dbname=app
DB_DSN=
DB_USERNAME=
DB_PASSWORD=
