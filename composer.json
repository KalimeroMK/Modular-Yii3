{
    "name": "kalimeromk/modular-yii3",
    "type": "project",
    "description": "Yii3 starter kit with modular architecture: describe a module in YAML, generate it with one command, tests included.",
    "keywords": [
        "yii3",
        "yii",
        "modular",
        "starter-kit",
        "code-generator",
        "yaml",
        "api",
        "ddd"
    ],
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/KalimeroMK/Modular-Yii3/issues",
        "source": "https://github.com/KalimeroMK/Modular-Yii3"
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./yii serve"
        ],
        "module-build": "@php ./yii module:build",
        "migrate": "@php ./yii migrate:up",
        "test": [
            "@php vendor/bin/phpunit",
            "@php vendor/bin/codecept run"
        ],
        "test-unit": "@php vendor/bin/phpunit",
        "cs-fix": "@php vendor/bin/php-cs-fixer fix",
        "psalm": "@php vendor/bin/psalm",
        "rector": "@php vendor/bin/rector process"
    },
    "require": {
        "php": "8.2 - 8.5",
        "ext-filter": "*",
        "httpsoft/http-message": "^1.1.6",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/log": "^3.0.2",
        "symfony/console": "^7.4.7 || ^8.0.7",
        "symfony/yaml": "^7.4",
        "yiisoft/active-record": "^1.1",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/assets": "^5.1.2",
        "yiisoft/cache": "^3.2",
        "yiisoft/config": "^1.6.2",
        "yiisoft/csrf": "^2.2.3",
        "yiisoft/data-response": "^2.2",
        "yiisoft/db": "^2.0",
        "yiisoft/db-migration": "^2.1",
        "yiisoft/db-sqlite": "^2",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/friendly-exception": "^1.2",
        "yiisoft/html": "^4",
        "yiisoft/http": "^1.3",
        "yiisoft/input-http": "^1.0.1",
        "yiisoft/log": "^2.2.0",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/request-body-parser": "^1.2",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/session": "^3.0.1",
        "yiisoft/strings": "^2.7",
        "yiisoft/validator": "^2.6",
        "yiisoft/view": "^12.2.4",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1",
        "yiisoft/yii-view-renderer": "^7.4.1"
    },
    "require-dev": {
        "vlucas/phpdotenv": "^5.6",
        "codeception/c3": "^2.9",
        "codeception/codeception": "^5.3.5",
        "codeception/module-asserts": "^3.3.0",
        "codeception/module-cli": "^2.0.1",
        "codeception/module-phpbrowser": "^4",
        "friendsofphp/php-cs-fixer": "^3.94.2",
        "phpunit/phpunit": "^11.5.55",
        "rector/rector": "^2.3.9",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true,
        "allow-plugins": {
            "yiisoft/config": true,
            "codeception/c3": true,
            "composer/installers": true
        }
    }
}
