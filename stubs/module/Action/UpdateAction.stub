<?php

declare(strict_types=1);

namespace {{ namespace }}\Application\Action;

use Psr\Http\Message\ResponseInterface;
use Yiisoft\DataResponse\ResponseFactory\JsonResponseFactory;
use Yiisoft\Http\Status;
use Yiisoft\Router\CurrentRoute;
use {{ namespace }}\Application\Dto\{{ module }}Input;
use {{ namespace }}\Application\Dto\{{ module }}Resource;
use {{ namespace }}\Application\Service\{{ module }}Service;
use {{ namespace }}\Domain\Exception\{{ module }}NotFoundException;

final readonly class UpdateAction
{
    public function __construct(
        private {{ module }}Service $service,
        private JsonResponseFactory $responseFactory,
    ) {}

    public function __invoke({{ module }}Input $input, CurrentRoute $currentRoute): ResponseInterface
    {
        $result = $input->getValidationResult();

        if (!$result->isValid()) {
            return $this->responseFactory->createResponse(
                ['error' => 'Validation failed', 'details' => $result->getErrorMessagesIndexedByProperty()],
                Status::UNPROCESSABLE_ENTITY,
            );
        }

        try {
            ${{ moduleVariable }} = $this->service->update((int) $currentRoute->getArgument('id'), $input);
        } catch ({{ module }}NotFoundException $e) {
            return $this->responseFactory->createResponse(['error' => $e->getMessage()], Status::NOT_FOUND);
        }

        return $this->responseFactory->createResponse(['data' => {{ module }}Resource::toArray(${{ moduleVariable }})]);
    }
}
